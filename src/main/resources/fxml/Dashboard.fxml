<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jewelry.controller.DashboardController"
      spacing="0" styleClass="content-area">

    <!-- ── Header ─────────────────────────────────────────────── -->
    <HBox styleClass="view-header" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="🏠 Dashboard" styleClass="view-title"/>
            <Label text="Business overview — revenue, profit, orders and inventory"
                   styleClass="label-muted"/>
        </VBox>
        <Label fx:id="lblLastRefresh" styleClass="label-muted" style="-fx-font-size:11px;"/>
        <ProgressIndicator fx:id="loadingIndicator" prefWidth="22" prefHeight="22" visible="false"/>
        <Button text="↻ Refresh" onAction="#onRefresh" styleClass="btn-secondary"/>
    </HBox>

    <!-- ── Dashboard Content (Scrollable) ─────────────────────── -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="0">
            <!-- ── KPI Cards Row ──────────────────────────────────────── -->
            <TilePane fx:id="kpiPane" hgap="12" vgap="12" prefColumns="4">
                <padding><Insets top="16" right="20" bottom="8" left="20"/></padding>
                <!-- Cards are built programmatically by DashboardController -->
            </TilePane>

            <!-- ── Charts + Side Panels ──────────────────────────────── -->
            <HBox VBox.vgrow="ALWAYS" spacing="16">
                <!-- Added a minWidth to the charts container to force a horizontal scrollbar if squished too far -->
                <padding><Insets top="8" right="20" bottom="20" left="20"/></padding>
                <minWidth>850</minWidth>

                <!-- Left Column (~55%) -->
                <VBox spacing="16" HBox.hgrow="ALWAYS" prefWidth="600">

                    <!-- Revenue over 6 months -->
                    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="dashboard-card" minHeight="250">
                        <Label text="📈 Monthly Revenue  (last 6 months)" styleClass="form-label"/>
                        <BarChart fx:id="revenueChart" VBox.vgrow="ALWAYS"
                                  animated="true"
                                  style="-fx-background-color:transparent;">
                            <xAxis><CategoryAxis fx:id="xAxis" label="Month"/></xAxis>
                            <yAxis><NumberAxis  fx:id="yAxis"  label="₹"/></yAxis>
                        </BarChart>
                    </VBox>

                    <!-- Order status pie -->
                    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="dashboard-card" minHeight="250">
                        <Label text="🥧 Orders by Status" styleClass="form-label"/>
                        <PieChart fx:id="statusPieChart" VBox.vgrow="ALWAYS"
                                  animated="true"
                                  style="-fx-background-color:transparent;"/>
                    </VBox>

                </VBox>

                <!-- Right Column (~45%) -->
                <VBox spacing="16" HBox.hgrow="SOMETIMES" prefWidth="480">

                    <!-- Top 5 products -->
                    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="dashboard-card" minHeight="250">
                        <Label text="🏆 Top 5 Products  (by units sold)" styleClass="form-label"/>
                        <TableView fx:id="topProductsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colTopName"    text="Product"/>
                                <TableColumn fx:id="colTopSku"     text="SKU"/>
                                <TableColumn fx:id="colTopUnits"   text="Units"/>
                                <TableColumn fx:id="colTopRevenue" text="Revenue"/>
                            </columns>
                            <placeholder>
                                <Label text="No completed orders yet" styleClass="label-muted"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- Low stock -->
                    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="dashboard-card" style="-fx-border-color: #e74c3c66;" minHeight="250">
                        <Label text="⚠️ Low Stock Alert  (≤ 5 units)" styleClass="form-label"
                               style="-fx-text-fill: #e74c3c;"/>
                        <ListView fx:id="lowStockList" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color:transparent; -fx-font-size:13px; -fx-control-inner-background: transparent;"/>
                    </VBox>

                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>

</VBox>
