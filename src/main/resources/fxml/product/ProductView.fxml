<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jewelry.controller.ProductViewController"
      spacing="0" styleClass="root-pane" VBox.vgrow="ALWAYS">

    <!-- ── Header ─────────────────────────────────────── -->
    <HBox styleClass="view-header" alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
        <Button text="⬅ Back" onAction="#onBack" styleClass="btn-secondary"/>
        <VBox spacing="2">
            <Label text="Product Details" styleClass="view-title"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="✎ Edit Product" onAction="#onEdit" styleClass="btn-primary"/>
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="form-scroll" VBox.vgrow="ALWAYS">
        <HBox spacing="24">
            <padding><Insets top="24" right="32" bottom="32" left="32"/></padding>

            <!-- ── Left: Image Section ───────────────────── -->
            <VBox spacing="10" prefWidth="300" minWidth="300" maxWidth="300">
                <StackPane prefHeight="300" styleClass="dashboard-card" style="-fx-background-color: #1a264a; -fx-background-radius: 8;">
                    <ImageView fx:id="imgProduct" fitWidth="280" fitHeight="280" preserveRatio="true" visible="false" managed="false"/>
                    <VBox fx:id="imagePlaceholderPane" alignment="CENTER" spacing="12">
                        <Label text="📷" style="-fx-font-size: 48px; -fx-text-fill: #3a4b7c;"/>
                        <Label text="No Image Available" styleClass="label-muted" style="-fx-font-size: 14px;"/>
                    </VBox>
                </StackPane>
                <!-- Reserved for future image upload controls -->
            </VBox>

            <!-- ── Right: Details Section ────────────────── -->
            <VBox spacing="20" HBox.hgrow="ALWAYS">
                <!-- Title & Tags -->
                <VBox spacing="8" styleClass="dashboard-card" style="-fx-padding: 24;">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label fx:id="lblName" text="Product Name" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="lblSku" text="SKU" styleClass="badge-success"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label fx:id="lblCategory" text="Category" styleClass="badge-info" style="-fx-background-color: #2b3d6b; -fx-text-fill: #a8bce6; -fx-padding: 4 10; -fx-background-radius: 12;"/>
                        <Label fx:id="lblMetal" text="Metal" styleClass="badge-info" style="-fx-background-color: #2b3d6b; -fx-text-fill: #a8bce6; -fx-padding: 4 10; -fx-background-radius: 12;"/>
                        <Label fx:id="lblPurity" text="Purity" styleClass="badge-info" style="-fx-background-color: #2b3d6b; -fx-text-fill: #a8bce6; -fx-padding: 4 10; -fx-background-radius: 12;"/>
                    </HBox>
                </VBox>

                <!-- Info Grid -->
                <GridPane hgap="32" vgap="24" styleClass="dashboard-card" style="-fx-padding: 24;">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- Row 1 -->
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Cost Price" styleClass="label-muted" style="-fx-font-size: 13px;"/>
                        <Label fx:id="lblCostPrice" text="₹ 0.00" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e0e0e0;"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Selling Price" styleClass="label-muted" style="-fx-font-size: 13px;"/>
                        <Label fx:id="lblSellingPrice" text="₹ 0.00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e2b04a;"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Est. Profit Margin" styleClass="label-muted" style="-fx-font-size: 13px;"/>
                        <Label fx:id="lblMargin" text="0%" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </VBox>

                    <!-- Row 2 -->
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Stock Available" styleClass="label-muted" style="-fx-font-size: 13px;"/>
                        <Label fx:id="lblQuantity" text="0 Units" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e0e0e0;"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Weight" styleClass="label-muted" style="-fx-font-size: 13px;"/>
                        <Label fx:id="lblWeight" text="0 g" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e0e0e0;"/>
                    </VBox>

                    <!-- Row 3 Description span all -->
                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="3">
                        <Region prefHeight="8"/>
                        <Separator style="-fx-opacity: 0.2;"/>
                        <Region prefHeight="8"/>
                        <Label text="Description" styleClass="label-muted" style="-fx-font-size: 13px;"/>
                        <Label fx:id="lblDescription" text="No description." wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #d0d0d0; -fx-line-spacing: 4px;"/>
                    </VBox>
                </GridPane>
            </VBox>
        </HBox>
    </ScrollPane>
</VBox>
