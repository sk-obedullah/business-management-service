<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jewelry.controller.CustomerListController"
      spacing="0" styleClass="content-area">

    <!-- ── Header ────────────────────────────────────────────── -->
    <HBox styleClass="view-header" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="👤 Customers" styleClass="view-title"/>
            <Label text="Manage your customer database" styleClass="label-muted"/>
        </VBox>

        <Label fx:id="lblTotal"  styleClass="badge-success"/>
        <Label fx:id="lblStatus" styleClass="label-muted"/>
        <ProgressIndicator fx:id="loadingIndicator" prefWidth="24" prefHeight="24" visible="false"/>
    </HBox>

    <!-- ── Toolbar ────────────────────────────────────────────── -->
    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="8">
        <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>

        <TextField fx:id="searchField"
                   promptText="🔍  Search by name, email or phone…"
                   styleClass="search-field"
                   HBox.hgrow="ALWAYS"
                   maxWidth="400"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnRefresh" text="↻ Refresh"       onAction="#onRefresh" styleClass="btn-secondary"/>
        <Button fx:id="btnAdd"     text="＋ Add Customer"  onAction="#onAdd"     styleClass="btn-primary"/>
        <Button fx:id="btnEdit"    text="✎ Edit"           onAction="#onEdit"    styleClass="btn-secondary"/>
        <Button fx:id="btnDelete"  text="✕ Delete"         onAction="#onDelete"  styleClass="btn-danger"/>
    </HBox>

    <!-- ── Table ─────────────────────────────────────────────── -->
    <TableView fx:id="customerTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colFullName" text="Full Name"    prefWidth="180"/>
            <TableColumn fx:id="colEmail"    text="Email"        prefWidth="220"/>
            <TableColumn fx:id="colPhone"    text="Phone"        prefWidth="130"/>
            <TableColumn fx:id="colAddress"  text="Address"      prefWidth="200"/>
            <TableColumn fx:id="colNotes"    text="Notes"        prefWidth="200"/>
            <TableColumn fx:id="colOrders"   text="Orders"       prefWidth="100"/>
        </columns>
        <placeholder>
            <Label text="No customers yet. Click '＋ Add Customer' to get started."
                   styleClass="label-muted"/>
        </placeholder>
    </TableView>

</VBox>
