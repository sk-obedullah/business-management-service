<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jewelry.controller.CustomerViewController"
      spacing="0" styleClass="root-pane" VBox.vgrow="ALWAYS">

    <!-- ── Header ─────────────────────────────────────── -->
    <HBox styleClass="view-header" alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
        <Button text="⬅ Back" onAction="#onBack" styleClass="btn-secondary"/>
        <VBox spacing="2">
            <Label text="Customer Profile" styleClass="view-title"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="✎ Edit Customer" onAction="#onEdit" styleClass="btn-primary"/>
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="form-scroll" VBox.vgrow="ALWAYS">
        <VBox spacing="24" alignment="TOP_CENTER">
            <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

            <!-- ── Top: Avatar & Name ───────────────────── -->
            <VBox spacing="16" alignment="CENTER" styleClass="dashboard-card" style="-fx-padding: 32; -fx-max-width: 600;">
                <StackPane>
                    <Circle radius="48" fill="#2b3d6b"/>
                    <Label fx:id="lblInitials" text="JD" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </StackPane>
                <Label fx:id="lblFullName" text="John Doe" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>

            <!-- ── Details Grid ────────────────── -->
            <GridPane hgap="32" vgap="24" styleClass="dashboard-card" style="-fx-padding: 32; -fx-max-width: 600;">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Row 1 -->
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Phone Number" styleClass="label-muted" style="-fx-font-size: 13px;"/>
                    <Label fx:id="lblPhone" text="+1 123 456 7890" style="-fx-font-size: 16px; -fx-text-fill: #e0e0e0;"/>
                </VBox>

                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Email Address" styleClass="label-muted" style="-fx-font-size: 13px;"/>
                    <Label fx:id="lblEmail" text="john.doe@example.com" style="-fx-font-size: 16px; -fx-text-fill: #e0e0e0;"/>
                </VBox>

                <!-- Row 2 -->
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <Region prefHeight="8"/>
                    <Separator style="-fx-opacity: 0.2;"/>
                    <Region prefHeight="8"/>
                    <Label text="Address" styleClass="label-muted" style="-fx-font-size: 13px;"/>
                    <Label fx:id="lblAddress" text="123 Example Street, City, Country" wrapText="true" style="-fx-font-size: 15px; -fx-text-fill: #d0d0d0; -fx-line-spacing: 4px;"/>
                </VBox>

                <!-- Row 3 -->
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                    <Region prefHeight="8"/>
                    <Separator style="-fx-opacity: 0.2;"/>
                    <Region prefHeight="8"/>
                    <Label text="Private Notes" styleClass="label-muted" style="-fx-font-size: 13px;"/>
                    <Label fx:id="lblNotes" text="No additional notes." wrapText="true" style="-fx-font-size: 15px; -fx-text-fill: #d0d0d0; -fx-line-spacing: 4px;"/>
                </VBox>
            </GridPane>
        </VBox>
    </ScrollPane>
</VBox>
